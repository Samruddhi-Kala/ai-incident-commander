# Application Configuration
APP_NAME="AI Incident Commander"
APP_ENV="development"
DEBUG=True
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="ai_incident_commander"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg://postgres:postgres_password@localhost:5432/ai_incident_commander"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Future Configuration Placeholders (Do not fill sensitive keys in source control)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
JWT_SECRET_KEY="development_jwt_secret_key_change_in_production"
